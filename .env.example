# Router configuration
ROUTER_URL=192.168.31.1
ROUTER_PASSWORD=your_password_here

# Application settings
LOGLEVEL=warn

# Debug endpoint (set to true only when troubleshooting)
ENABLE_DEBUG=false

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_strong_password

# Grafana anonymous access (keep false unless you intentionally want public viewer access)
GRAFANA_ANONYMOUS_ENABLED=false
